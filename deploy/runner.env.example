# ~/.config/tether/runner.env (chmod 600). One per runner.
# The Tether app's base URL and this runner's app service token (named runner-<name>).
TETHER_URL=https://tether.example.com
TETHER_TOKEN=
# Most sessions this runner keeps live at once (default: no limit). Sending to one more is refused
# with a clear error until another goes idle.
#TETHER_MAX_LIVE_SESSIONS=4
# Texting (optional): each person's own number and credentials; never share a bot or a number.
#TETHER_TEXT_PHONE=+15555550100
#TETHER_PHOTON_PROJECT_ID=
#TETHER_PHOTON_PROJECT_SECRET=
#TETHER_DISCORD_TOKEN=
#TETHER_DISCORD_OWNER_IDS=
#TETHER_DISCORD_CHANNEL_ID=
